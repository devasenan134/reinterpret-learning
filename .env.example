# LLM provider: anthropic | openai_compat (OpenAI, Ollama, any compatible server)
LLM_PROVIDER=anthropic
# anthropic default is claude-opus-5-5. Cheaper: claude-sonnet-5-5, claude-haiku-5-5. Required for openai_compat.
LLM_MODEL=
# anthropic: leave empty to use ANTHROPIC_API_KEY or `ant auth login`
LLM_API_KEY=
# openai_compat only, e.g. http://localhost:11434/v1 for Ollama (default: OpenAI)
LLM_BASE_URL=
# anthropic only: low | medium | high. Low is quicker for short margin notes.
LLM_EFFORT=low
# SQLite file
DB_PATH=reinterpret.db
